{
    "$schema":  "node_modules/wrangler/config-schema.json",
    "name":  "jornadas",
    "compatibility_date":  "2026-09-10",
    "compatibility_flags":  [
                                "nodejs_compat"
                            ],
    "main":  "vinext/server/fetch-handler",
    "assets":  {
                   "directory":  "dist/client",
                   "not_found_handling":  "none",
                   "binding":  "ASSETS"
               },
    "cache":  {
                  "enabled":  true
              },
    "r2_buckets":  [
                       {
                           "binding":  "UPLOADS",
                           "bucket_name":  "jornadas-uploads"
                       }
                   ],
    "vars":  {},
    "observability":  {
                          "enabled":  true,
                          "head_sampling_rate":  1
                      },
    "version_metadata":  {
                             "binding":  "CF_VERSION_METADATA"
                         },
    "hyperdrive":  [
                       {
                           "binding":  "HYPERDRIVE",
                           "id":  "ad753ce1f6974eb0afca790428bb60f3"
                       }
                   ]
}