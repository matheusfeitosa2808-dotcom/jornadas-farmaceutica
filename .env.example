DATABASE_URL="file:./dev.db"
# Production: DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/jornadas?schema=public"
APP_ORIGIN="http://127.0.0.1:3000"
DEV_SEED="true"
PARTICIPANT_LOGIN_DISABLED="false"
