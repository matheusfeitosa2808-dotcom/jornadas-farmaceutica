{
    "$schema":  "node_modules/wrangler/config-schema.json",
    "name":  "jornadas",
    "compatibility_date":  "2026-09-10",
    "compatibility_flags":  [
                                "nodejs_compat"
                            ],
    "main":  "src/worker-entry.ts",
    "assets":  {
                   "directory":  "dist/client",
                   "not_found_handling":  "none",
                   "binding":  "ASSETS"
               },
    "cache":  {
                  "enabled":  true
              },
    "r2_buckets":  [
                       {
                           "binding":  "UPLOADS",
                           "bucket_name":  "jornadas-uploads"
                       }
                   ],
    "vars":  {},
    "observability":  {
                          "enabled":  true,
                          "head_sampling_rate":  1
                      },
    "version_metadata":  {
                             "binding":  "CF_VERSION_METADATA"
                         },
    "hyperdrive":  [
                       {
                           "binding":  "HYPERDRIVE",
                           "id":  "ad753ce1f6974eb0afca790428bb60f3"
                       }
                   ],
    "durable_objects":  {
                            "bindings":  [
                                             { "name":  "EDITION_HUB", "class_name":  "EditionHub" }
                                         ]
                        },
    "migrations":  [
                       { "tag":  "v1", "new_sqlite_classes":  ["EditionHub"] }
                   ],
    "ratelimits":  [
                       { "name":  "LOGIN_LIMIT", "namespace_id":  "1001", "simple":  { "limit":  10, "period":  60 } },
                       { "name":  "ACTION_LIMIT", "namespace_id":  "1002", "simple":  { "limit":  120, "period":  60 } }
                   ]
}