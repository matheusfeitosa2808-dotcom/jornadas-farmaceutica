{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/server/db": ["./src/server/db.pg.ts"],
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "vite.config.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "dist",
    ".vinext",
    ".wrangler",
    "backup-before-cloudflare",
    "src/generated/prisma-cloudflare",
    "src/server/db.cloudflare.ts",
    "src/server/storage.cloudflare.ts",
    "src/server/password.cloudflare.ts",
    "src/server/ratelimit.cloudflare.ts",
    "src/realtime/EditionHub.ts",
    "src/server/publish.cloudflare.ts",
    "src/worker-entry.ts",
    "worker-configuration.d.ts"
  ]
}
