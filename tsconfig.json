{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/server/db": [
        "./src/server/db.pg.ts"
      ],
      "@/server/storage": [
        "./src/server/storage.cloudflare.ts"
      ],
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "vite.config.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "dist",
    ".vinext",
    ".wrangler",
    "backup-before-cloudflare",
    "src/generated/prisma-cloudflare",
    "src/server/db.cloudflare.ts",
    "worker-configuration.d.ts",
    "src/realtime",
    "src/worker-entry.ts",
    "src/server/password.cloudflare.ts",
    "src/server/password.ts",
    "src/server/ratelimit.cloudflare.ts",
    "src/server/ratelimit.ts",
    "src/server/publish.cloudflare.ts",
    "src/server/publish.ts"
  ]
}
